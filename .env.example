# =============================================================================
# AZIB | عازب — Environment Variables Example
# =============================================================================

# Database Connection
# For local development via Docker
DATABASE_URL="postgresql://azib_user:azib_password@localhost:5432/azib_db?schema=public"

# Direct URL (Used for migrations in some Supabase/Pooler setups)
DIRECT_URL="postgresql://azib_user:azib_password@localhost:5432/azib_db?schema=public"

# API Settings (Placeholder for future API app)
API_PORT=4000

# Frontend URLs (Placeholder for future apps)
NEXT_PUBLIC_API_URL="http://localhost:4000"
